# Optional. Enables the WalletConnect button for phone wallets.
# Create a project at https://cloud.reown.com
NEXT_PUBLIC_WC_PROJECT_ID=

# Optional. Used as the WalletConnect app URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Slip pay contract on Robinhood Chain. Leave empty until you deploy.
# Payments then add the fee on top of the due. The owner withdraws at /withdraw.
NEXT_PUBLIC_SLIP_PAY=

# Book key for the receipt list, the CSV, and writing new slips. A shared slip link stays open without it.
# If empty, this computer generates data/book-secret and shows the key on /unlock at localhost only.
# SLIP_BOOK_SECRET=

# Optional. Push notifications use a keypair generated into data/vapid.json when these are empty.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Deploy only (scripts/deploy-slip-pay.ts). SLIP_OWNER can withdraw. It is an address, not a key.
# SLIP_OWNER=
# DEPLOYER_PRIVATE_KEY=
